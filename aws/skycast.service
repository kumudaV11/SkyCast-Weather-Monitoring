[Unit]
Description=SKYCAST Intelligent Weather Monitoring Flask WSGI Service
After=network.target

[Service]
User=skycast
Group=www-data
WorkingDirectory=/var/www/skycast
Environment="PATH=/var/www/skycast/.venv/bin"
Environment="PORT=5000"
Environment="FLASK_DEBUG=0"
ExecStart=/var/www/skycast/.venv/bin/gunicorn \
    --workers 3 \
    --bind 127.0.0.1:5000 \
    --timeout 30 \
    --access-logfile /var/log/skycast/access.log \
    --error-logfile /var/log/skycast/error.log \
    app:app

Restart=always
RestartSec=5
KillMode=mixed
PrivateTmp=true

[Install]
WantedBy=multi-user.target
