# SKYCAST Configuration Environment Variables
FLASK_DEBUG=0
PORT=5000
HOST=0.0.0.0
SECRET_KEY=change-this-in-production-skycast-key
DEFAULT_CITY=Bengaluru

# Optional AWS DynamoDB Search History Sync
ENABLE_DYNAMODB=0
AWS_REGION=ap-south-1
DYNAMODB_TABLE=SkycastSearchHistory
S3_BUCKET_NAME=skycast-weather-assets-college
